# Cesium ion token — https://ion.cesium.com/tokens
# Enables Cesium World Terrain + Cesium OSM Buildings. Without it the app
# falls back to public Esri imagery, flat terrain and OSM-footprint buildings.
VITE_CESIUM_ION_TOKEN=

# Optional: Google Photorealistic 3D Tiles (requires a Google Maps Platform key
# with the Map Tiles API enabled AND permission to use it). Off by default.
VITE_GOOGLE_MAPS_API_KEY=
VITE_ENABLE_GOOGLE_3D_TILES=false

# Optional: base URL of the FastAPI inference server (see server/main.py).
# Leave empty to use the Vite dev proxy (/api -> http://127.0.0.1:8000).
VITE_INFERENCE_API_URL=
